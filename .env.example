NODE_ENV=production
PORT=3000

# Azure SQL
DB_SERVER=your-server.database.windows.net
DB_PORT=1433
DB_NAME=your_database
DB_USER=your_database_user
DB_PASSWORD=replace_with_database_password

# Browser and session security
FRONTEND_ORIGIN=https://your-public-site.example
SESSION_SECRET=replace_with_at_least_32_random_characters
COOKIE_SECURE=true
COOKIE_SAME_SITE=lax
APP_BASE_URL=https://your-app.example

# Paid access
REPORT_BASE_URL=https://your-app.example/BCC.html
PAYMENT_URL=
TOKEN_ISSUER_API_KEY=replace_with_a_long_random_server_to_server_key
STRIPE_SECRET_KEY=replace_with_stripe_secret_key
STRIPE_PRICE_ID=replace_with_stripe_price_id

# Optional ArcGIS POD import
ARCGIS_FEATURE_URL=
ARCGIS_TOKEN=
ENABLE_POD_ARCGIS=false

# Visual Approvals report API
VA_API_KEYS=replace_with_a_long_random_api_key
VA_REQUIRE_HTTPS=true
VA_STORAGE_DIR=storage
