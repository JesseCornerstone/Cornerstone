# VA / Visual Approvals API access
# Use a long random value. Multiple active keys can be comma separated.
VA_API_KEYS=replace_with_long_random_key

# Require HTTPS for VA API calls. Keep true in production.
VA_REQUIRE_HTTPS=true

# Optional local storage directory for VA request metadata and generated reports.
# Azure Blob Storage can replace this in a later production storage pass.
VA_STORAGE_DIR=storage
